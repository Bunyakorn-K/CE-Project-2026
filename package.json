{
  "name": "laundrytwin",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "NODE_ENV=development LAUNDRYTWIN_DEV_BYPASS=true concurrently -n api,web -c cyan,magenta \"pnpm --filter @laundrytwin/api dev\" \"pnpm --filter @laundrytwin/web dev\"",
    "build": "pnpm --filter @laundrytwin/api build && pnpm --filter @laundrytwin/web build",
    "check": "pnpm --filter @laundrytwin/api check && pnpm --filter @laundrytwin/web check && pnpm --filter @laundrytwin/etl check",
    "test": "pnpm --filter @laundrytwin/api test && pnpm --filter @laundrytwin/web test && pnpm --filter @laundrytwin/etl test",
    "etl": "pnpm --filter @laundrytwin/etl start",
    "db:generate": "pnpm --filter @laundrytwin/api db:generate",
    "db:push": "pnpm --filter @laundrytwin/api db:push"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "turbo": "^2.10.12"
  },
  "pnpm": {
    "overrides": {
      "nanoid@<3.3.18": "^3.3.18",
      "postcss@<=8.5.22": "^8.5.22",
      "esbuild@0.18.20": "0.25.12",
      "follow-redirects@<1.16.2": "^1.16.2",
      "qs@<6.16.1": "^6.16.1",
      "undici@<7.30.1": "^7.30.1",
      "seroval@<=1.6.7": "^1.6.11",
      "fast-uri@<3.1.9": "^3.1.9",
      "ip-address@<=10.7.3": "^10.7.4",
      "proxy-addr@<2.0.8": "^2.0.8",
      "shell-quote@<1.11.0": "^1.11.0",
      "body-parser@<2.4.0": "^2.4.0",
      "source-map-js@<1.2.2": "^1.2.2",
      "baseline-browser-mapping@<2.11.0": "^2.11.0",
      "browserslist@<=4.28.6": "^4.28.7",
      "zod@<4.6.6": "^4.6.6",
      "@vitest/mocker@<4.1.12": "^4.1.12",
      "axios@<1.20.0": "^1.20.0"
    }
  }
}
