{
  "name": "laundrytwin",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm --filter @laundrytwin/api dev\" \"pnpm --filter @laundrytwin/web dev\"",
    "build": "pnpm --filter @laundrytwin/api build && pnpm --filter @laundrytwin/web build",
    "check": "pnpm --filter @laundrytwin/api check && pnpm --filter @laundrytwin/web check",
    "test": "pnpm --filter @laundrytwin/api test && pnpm --filter @laundrytwin/web test",
    "db:generate": "pnpm --filter @laundrytwin/api db:generate",
    "db:push": "pnpm --filter @laundrytwin/api db:push"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
