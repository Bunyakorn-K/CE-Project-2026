# Use a unique value of at least 32 characters before deploying.
BETTER_AUTH_SECRET=replace-with-a-unique-32-character-minimum-secret
BETTER_AUTH_URL=http://localhost:8787
CORS_ORIGIN=http://localhost:5173
DATABASE_PATH=apps/api/data/laundrytwin.sqlite
LAUNDRYTWIN_BOOTSTRAP_ADMIN_EMAIL=owner@example.com

# Explicit local preview only. Set true to enable labeled demo data and Demo Owner session.
LAUNDRYTWIN_DEMO_MODE=false

# Server-only IRIS reporting integration. The browser must never receive this key.
IRIS_READ_BASE_URL=
IRIS_LAUNDRYTWIN_READ_API_KEY=

# LINE Login channel ID verifies LIFF ID tokens on the server.
LINE_LOGIN_CHANNEL_ID=

# Frontend only. Leave empty for the local Vite proxy, or set the deployed API origin.
# Do not add a channel secret here.
VITE_API_URL=
VITE_LIFF_ID=

# Backend only. Leave blank to keep the optional LINE webhook disabled.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Analytics warehouse (ClickHouse HTTP interface)
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=laundrytwin_analytics
