# macOS
.DS_Store
**/.DS_Store

# Dependencies and build output
node_modules/
dist/

# Local environment and runtime data
.env
*.sqlite
*.sqlite-shm
*.sqlite-wal
apps/api/data/
apps/api/drizzle/
data/

# ETL runtime state (cursor watermark advances; not a source-of-truth file)
apps/etl/etl-watermark.json
apps/etl/.tmp/

# Local tooling
.impeccable/hook.cache.json
.firecrawl/
.claude/
.opencode/
.archify/

# Coverage / profiling output
*.profraw

# Rendered diagram/image output (sources are tracked: docs/diagrams/*.mmd)
docs/diagrams/*.png
generated-images/

# TypeScript build info
*.tsbuildinfo

# Playwright runtime output (traces, screenshots, HTML report)
test-results/
playwright-report/
blob-report/

# graphify knowledge-graph output (regenerated by `graphify .` / `graphify update .`; do not commit)
graphify-out/
.graphify_mcp_key
