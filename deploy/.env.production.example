# Copy this file to .env on the VM. Do not commit the resulting .env file.
BETTER_AUTH_SECRET=replace-with-a-unique-32-character-minimum-secret
BETTER_AUTH_URL=https://laundrytwin.duckdns.org
CORS_ORIGIN=https://laundrytwin.duckdns.org
LAUNDRYTWIN_BOOTSTRAP_ADMIN_EMAIL=owner@example.com
LAUNDRYTWIN_DEMO_MODE=false
LAUNDRYTWIN_DEV_BYPASS=false
MCP_ACCESS_TOKEN=replace-with-a-random-service-token
MCP_ALLOW_REVENUE=false

# Server-only IRIS reporting integration.
IRIS_READ_BASE_URL=https://iris.example/v1/laundrygo
IRIS_LAUNDRYTWIN_READ_API_KEY=replace-with-the-dedicated-read-key

# LINE LIFF. VITE_LIFF_ID is injected at web-image build time.
# LINE_LOGIN_CHANNEL_IDS accepts a comma-separated list of the channel IDs the
# ID token's `aud` may carry; the API tries each as `client_id` against
# api.line.me/oauth2/v2.1/verify. LINE_LOGIN_CHANNEL_ID is the legacy single
# channel fallback.
#
# READ docs/02_architecture/deploy-runbook.md "LINE LIFF login configuration"
# BEFORE CHANGING THESE. Short version: the ID token is only issued when the
# LIFF app has the `openid` scope. That scope is set on the LIFF app itself —
# LINE Developers Console → provider → channel → LIFF tab → Scope, or on a LINE
# MINI App the Web app settings tab → Scopes. A MINI App is a valid place to do
# this; it is not restricted to LINE Login channels.
#
# The values below are the MINI App measured on 2026-09-30. Its `openid` scope
# was added the same day, so this LIFF ID is now expected to issue a token.
# Re-read the runbook's measurement note before assuming either way.
VITE_LIFF_ID=2011592166-uToRdTwS
LINE_LOGIN_CHANNEL_IDS=2011592166,2011592167,2011592168
LINE_LOGIN_CHANNEL_ID=

# Leave these empty until the optional LINE Messaging API webhook is configured.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Alert engine: ms between pushes for the same alert class (branch + rule + severity).
# Optional; default 3600000 (1 hour). Run sweeps with `pnpm --filter @laundrytwin/api alerts:sweep`.
ALERT_COOLDOWN_MS=3600000

# Analytics warehouse (ClickHouse HTTP interface)
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=replace-with-admin-clickhouse-password
CLICKHOUSE_READER_PASSWORD=replace-with-reader-clickhouse-password
CLICKHOUSE_DATABASE=laundrytwin_analytics
