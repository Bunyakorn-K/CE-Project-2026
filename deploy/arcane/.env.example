# Arcane — Docker management UI (VM 117, /opt/arcane)
# Real values live only in the VM's /opt/arcane/.env (chmod 600). Never commit them.

APP_URL=http://172.30.191.48:3552
PUID=1000
PGID=1000

# generate with: openssl rand -hex 32
ENCRYPTION_KEY=
JWT_SECRET=

# Authentik OIDC SSO — application slug "arcane" on https://auth.notnotik.duckdns.org
# Access restricted by Authentik policy to the "final project member" group.
# group claim "final project member" -> Arcane role_editor (can edit compose/containers,
# cannot manage users/settings). Local arcane admin stays as break-glass.
OIDC_ENABLED=true
OIDC_CLIENT_ID=arcane-laundrytwin
OIDC_CLIENT_SECRET=
OIDC_ISSUER_URL=https://auth.notnotik.duckdns.org/application/o/arcane/
OIDC_SCOPES=openid email profile groups
OIDC_GROUPS_CLAIM=groups
OIDC_ROLE_MAPPINGS=[{"claimValue":"final project member","roleId":"role_editor"}]
