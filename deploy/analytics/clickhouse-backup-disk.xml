<clickhouse>
    <!-- Native backup disk for ClickHouse BACKUP/RESTORE.
         Path must be a subdirectory under the volume mount for persistence.
         See: https://clickhouse.com/docs/concepts/features/backup-restore/local-disk -->
    <storage_configuration>
        <disks>
            <backups>
                <type>local</type>
                <path>/backups/</path>
            </backups>
        </disks>
    </storage_configuration>
    <backups>
        <allowed_disk>backups</allowed_disk>
        <allowed_path>/backups/</allowed_path>
    </backups>
</clickhouse>
