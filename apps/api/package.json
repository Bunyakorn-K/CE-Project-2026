{
  "name": "@laundrytwin/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "build:prod": "node esbuild.config.mjs",
    "build": "tsc --noEmit",
    "check": "tsc --noEmit",
    "test": "vitest run --fileParallelism=false",
    "alerts:sweep": "tsx scripts/run-alert-sweep.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.47",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@hono/node-server": "^2.1.3",
    "@line/bot-sdk": "^9.9.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@scalar/hono-api-reference": "^0.11.16",
    "ai": "^7.0.97",
    "better-auth": "^1.7.7",
    "better-sqlite3": "^12.8.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.13.11",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.25.12",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
