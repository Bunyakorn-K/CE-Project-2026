# LaundryTwin ETL — read IRIS Postgres machine-usage data -> ClickHouse

# Postgres (IRIS main `iris_project` DB). External access requires TLS + scram.
# Example: postgresql://iris_reader:password@172.30.186.206:5432/iris_project?sslmode=require
PG_CONNECTION_STRING=postgresql://user:password@host:5432/iris_project

# ClickHouse (LaundryTwin analytics warehouse)
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=laundrytwin_analytics

# Watermark state file (advanced only after each committed batch)
ETL_WATERMARK_PATH=./etl-watermark.json

# On a fresh run with no saved watermark, how far back to load (days). 0 = only
# new rows. The code default is 0 and so is this file; the Terraform variable
# `etl_since_fallback_days` (deploy/tofu/variables.tf) still DEFAULTS TO 30, so
# check the deployed /opt/laundrytwin-etl/.env before assuming 0.
# A large value is only safe while a watermark exists: if the watermark is lost,
# the temperature read restarts that many days back over the full table.
ETL_SINCE_FALLBACK_DAYS=0

# Batch sizes (rows per POST to ClickHouse)
ETL_USAGE_BATCH=2000
ETL_TEMPERATURE_BATCH=20000

# --- Failure budgets (added 2026-09-29 after the four-day hang) --------------
# A blocked source statement used to be invisible: the wrapper loop kept running
# and nothing was logged. Every one of these turns a stall into a logged error.
# All of them accept 0 to disable.

# Server-side cap on one source statement (ms). A healthy temperature page is an
# index range over the lag-guard window, so this is far above what it needs.
ETL_PG_STATEMENT_TIMEOUT_MS=180000
# Cap on establishing a source connection (ms).
ETL_PG_CONNECT_TIMEOUT_MS=10000
# Cap on a source session left idle inside a transaction (ms).
ETL_PG_IDLE_IN_TX_TIMEOUT_MS=30000
# Cap on one ClickHouse HTTP request (ms).
ETL_CH_REQUEST_TIMEOUT_MS=120000
# Cap on one ETL phase (ms). Exceeding it fails the run loudly.
ETL_PHASE_TIMEOUT_MS=900000

# How far behind wall-clock the temperature read stops (hours). The read keys on
# occurred_at, so a sample whose event time is older than the cursor but which
# lands in IRIS afterwards would sit permanently behind the cursor; this lag is
# the room left for that. The real worst-case occurred_at -> ingested_at delay in
# IRIS has never been measured from this repository.
ETL_TEMPERATURE_LAG_HOURS=24

# Operator escape hatch: pin the temperature start to an ISO-8601 instant
# instead of the stored watermark. Wins over any watermark, including the
# one-time ingested_at -> occurred_at re-anchor. Rows before this instant are
# NOT re-read, and re-reading a window that is already loaded would duplicate
# rows in fact_temperature_sample (a plain MergeTree). Leave empty.
ETL_TEMPERATURE_SINCE_ISO=
